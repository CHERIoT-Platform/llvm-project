declare dso_local void @wobble(ptr addrspace(200)) local_unnamed_addr addrspace(200) #0

define dso_local noundef i32 @wombat(i64 noundef %arg) local_unnamed_addr addrspace(200) #1 {
bb:
; CHECK-LABEL: define {{.*}} @wombat(
; CHECK-NOT:   alloca
; CHECK:       call addrspace(200) ptr addrspace(200) @llvm.cheri.cap.untagged.from.int.i64(
; CHECK:       tail call addrspace(200) void @wobble(
  %alloca = alloca ptr addrspace(200), align 8, addrspace(200)
  store i64 %arg, ptr addrspace(200) %alloca, align 8, !tbaa !12
  %load = load ptr addrspace(200), ptr addrspace(200) %alloca, align 8
  tail call addrspace(200) void @wobble(ptr addrspace(200) %load) #3
  ret i32 0
}

define dso_local noundef i32 @hoge(ptr addrspace(200) nofree noundef readonly captures(none) %arg) local_unnamed_addr addrspace(200) #1 {
bb:
; CHECK-NOT:   alloca
; CHECK:       call addrspace(200) ptr addrspace(200) @llvm.cheri.cap.untagged.from.int.i64(
; CHECK:       tail call addrspace(200) void @wobble(
  %alloca = alloca ptr addrspace(200), align 8, addrspace(200)
  %load = load i64, ptr addrspace(200) %arg, align 8, !tbaa !13
  call addrspace(200) void @llvm.lifetime.start.p200(ptr addrspace(200) nonnull %alloca)
  store i64 %load, ptr addrspace(200) %alloca, align 8, !tbaa !12
  %load2 = load ptr addrspace(200), ptr addrspace(200) %alloca, align 8
  tail call addrspace(200) void @wobble(ptr addrspace(200) %load2) #3
  call addrspace(200) void @llvm.lifetime.end.p200(ptr addrspace(200) nonnull %alloca)
  ret i32 0
}

