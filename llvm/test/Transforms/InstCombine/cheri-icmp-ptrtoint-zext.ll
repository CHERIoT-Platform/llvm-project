; RUN: opt -passes=instcombine -S < %s | FileCheck %s

; This used to crash: the RHS isn't a ptrtoint or constant.

target datalayout = "e-m:e-p:32:32-pfe200:64:64:64:32-i64:64-n32-S128-A200-P200-G200"

define i1 @ptrtoint_cap_eq_zext(ptr addrspace(200) %p, i16 %x) addrspace(200) {
; CHECK-LABEL: @ptrtoint_cap_eq_zext(
; CHECK-NEXT:    [[A:%.*]] = ptrtoint ptr addrspace(200) [[P:%.*]] to i32
; CHECK-NEXT:    [[B:%.*]] = zext i16 [[X:%.*]] to i32
; CHECK-NEXT:    [[C:%.*]] = icmp eq i32 [[A]], [[B]]
; CHECK-NEXT:    ret i1 [[C]]
;
  %a = ptrtoint ptr addrspace(200) %p to i32
  %b = zext i16 %x to i32
  %c = icmp eq i32 %a, %b
  ret i1 %c
}
